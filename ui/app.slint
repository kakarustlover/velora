            OptCard { group: 1; k: 1; label: Names.eqlook[1]; selected: AppState.eq-look == 1; tapped => { AppState.set-eq-look(1); } }
            OptCard { group: 1; k: AppState.eq-look >= 3 ? AppState.eq-look : 2; label: Names.eqlook[self.k]; selected: AppState.eq-look == self.k; tapped => { AppState.set-eq-look(self.k); } }
            OptCard { group: 3; k: 0; label: "More"; tapped => { AppState.more-kind = 3; } }
        }
