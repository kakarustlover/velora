// =============================================================================
//  app.slint - Velora UI, a 1:1 port of Velora-FINAL.html (measured values)
//  Measured with a real browser at 360x800 and 412x915 (see scripts/ + docs/SPEC.md)
// =============================================================================
import "fonts/Inter-Regular.ttf";
import "fonts/Inter-Medium.ttf";
import "fonts/Inter-SemiBold.ttf";
import "fonts/Inter-Bold.ttf";
import "fonts/Inter-ExtraBold.ttf";

import { Theme } from "theme.slint";
import { AppState, ListRow, PlCard, PickRow } from "state.slint";
import { Ic } from "icons_data.slint";
import { Pal } from "tokens.slint";
import { Walls } from "walls.slint";
import { Icon, Glass, GButton, GhostButton, Switch, SeekBar, HSlider, VSlider, CoverTile, Sect, PalCard, WallCard, OptCard, ModeRow } from "components.slint";

export { AppState, ListRow, PlCard, PickRow }

global Names {
    out property <[string]> pal: ["Blue", "Orange", "Bone", "Pistachio", "Violet", "Rose", "Teal", "Gold", "Graphite", "Wine"];
    out property <[string]> wall: ["Bokeh", "Aurora", "Silk", "Horizon", "Plain"];
    out property <[string]> cover: ["Card", "Square", "Disc", "Circle", "Wide", "Frame"];
    out property <[string]> eqlook: ["Bars", "Spectrum", "Dots", "Thin", "Bold", "Off"];
    out property <[string]> preset: ["Flat", "Bass", "Treble", "Vocal", "Rock", "Pop", "Jazz", "Electronic", "Custom"];
    out property <[string]> hz: ["31", "62", "125", "250", "500", "1k", "2k", "4k", "8k", "16k"];
}

// -----------------------------------------------------------------------------
// Logo: five bars (HTML ".lg2"). Calm when idle, lively while music plays.
// -----------------------------------------------------------------------------
component LogoBars inherits Rectangle {
    in property <length> w: 38px;
    in property <color> c: Theme.ttl;
    width: w;
    height: w * 40 / 56;
    for h[j] in [30, 22, 14, 22, 30] : Rectangle {
        property <float> k: root.width / 56px;
        property <float> wave: 0.5 + 0.5 * Math.sin(AppState.phase * (AppState.playing ? 5 : 1) + j * 72deg);
        property <float> sc: AppState.playing ? 0.35 + 0.65 * wave : 0.6 + 0.4 * wave;
        x: (7.5px + j * 9px) * k;
        width: 5px * k;
        height: h * 1px * k * sc;
        y: (root.height - self.height) / 2;
        border-radius: self.width / 2;
        background: root.c;
    }
}

// -----------------------------------------------------------------------------
// Tab chip (HTML ".chips .tab"): icon only, the selected one expands to show its label
// -----------------------------------------------------------------------------
component Chip inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> selected;
    callback tapped();
    height: 48px;
    border-radius: 20px;
    clip: true;
    if !Theme.flat : Image {
        x: -root.absolute-position.x;
        y: -root.absolute-position.y;
        width: AppState.win-w;
        height: AppState.win-h;
        source: Theme.blur-wall;
        image-fit: cover;
        opacity: root.selected ? 0.0 : 1.0;
    }
    Rectangle {
        background: @linear-gradient(145deg, Theme.g1 0%, Theme.g2 100%);
        opacity: root.selected ? 0.0 : 1.0;
        animate opacity { duration: 300ms; }
    }
    Rectangle {
        background: @linear-gradient(145deg, Theme.acc1 0%, Theme.acc2 100%);
        opacity: root.selected ? 1.0 : 0.0;
        animate opacity { duration: 300ms; }
    }
    Rectangle { border-radius: 20px; border-width: 1px; border-color: Theme.lo; }
    Rectangle { x: 12px; y: 0px; width: root.width - 24px; height: 1px; background: Theme.hi; }
    HorizontalLayout {
        alignment: center;
        spacing: 6px;
        Rectangle {
            width: 20px;
            Icon {
                d: root.icon;
                size: 20px;
                c: root.selected ? Theme.acct : Theme.smu;
                y: (root.height - 20px) / 2;
            }
        }
        if root.selected && root.label != "" : Text {
            text: root.label;
            font-size: 13px;
            font-weight: 700;
            color: Theme.acct;
            vertical-alignment: center;
        }
    }
    TouchArea { clicked => { root.tapped(); } }
}

// -----------------------------------------------------------------------------
// Song / album / singer row (HTML ".row"): 58px, cover 42, title 16/600, sub 14
// -----------------------------------------------------------------------------
component SongRow inherits Rectangle {
    in property <ListRow> data;
    in property <bool> current;
    callback tapped();
    height: 58px;
    border-radius: 22px;
    if current : Rectangle {
        border-radius: 22px;
        background: @linear-gradient(145deg, Theme.g1 0%, Theme.g2 100%);
        border-width: 1px;
        border-color: Theme.lo;
    }
    CoverTile {
        x: 8px;
        y: 8px;
        width: 42px;
        height: 42px;
        key: data.cover;
        hue: data.hue;
    }
    Text {
        x: 62px;
        y: 11.5px;
        width: root.width - 62px - (data.right != "" ? 82px : 14px) - (current ? 22px : 0px);
        height: 19px;
        text: data.title;
        font-size: 16px;
        font-weight: 600;
        color: Theme.tx;
        overflow: elide;
    }
    Text {
        x: 62px;
        y: 30.5px;
        width: root.width - 62px - (data.right != "" ? 82px : 14px) - (current ? 22px : 0px);
        height: 16px;
        text: data.sub;
        font-size: 14px;
        color: Theme.mu;
        overflow: elide;
    }
    Text {
        x: root.width - 8px - 56px;
        y: 21px;
        width: 56px;
        height: 16px;
        text: data.right;
        font-size: 14px;
        color: Theme.mu;
        horizontal-alignment: right;
    }
    if current : Rectangle {
        x: root.width - 8px - 56px - 8px - 13px;
        y: 21px;
        width: 13px;
        height: 16px;
        for j in 3 : Rectangle {
            property <float> lv: AppState.playing ? 0.3 + 0.7 * (0.5 + 0.5 * Math.sin(AppState.phase * 6 + j * 100deg)) : 0.3;
            x: j * 5px;
            width: 3px;
            height: 16px * lv;
            y: 16px - self.height;
            border-radius: 1.5px;
            background: Theme.a2;
        }
    }
    TouchArea { clicked => { root.tapped(); } }
}

// -----------------------------------------------------------------------------
// Playlist card with a 2x2 cover mosaic (HTML ".plcard")
// -----------------------------------------------------------------------------
component PlaylistCard inherits Rectangle {
    in property <PlCard> c;
    callback tapped();
    border-radius: 24px;
    Rectangle { border-radius: 24px; background: @linear-gradient(145deg, Theme.g1 0%, Theme.g2 100%); }
    Rectangle { border-radius: 24px; border-width: 0.5px; border-color: Theme.lo; }
    Rectangle {
        x: 10px;
        y: 10px;
        width: root.width - 20px;
        height: self.width;
        border-radius: 18px;
        background: Theme.g2;
        property <length> cw: (self.width - 12px) / 2;
        CoverTile { x: 4px; y: 4px; width: parent.cw; height: parent.cw; key: c.k1; hue: c.h1; radius: 12px; icon-size: 16px; rings: false; opacity: c.n >= 1 ? 1.0 : 0.35; }
        CoverTile { x: 8px + parent.cw; y: 4px; width: parent.cw; height: parent.cw; key: c.k2; hue: c.h2; radius: 12px; icon-size: 16px; rings: false; opacity: c.n >= 2 ? 1.0 : 0.35; }
        CoverTile { x: 4px; y: 8px + parent.cw; width: parent.cw; height: parent.cw; key: c.k3; hue: c.h3; radius: 12px; icon-size: 16px; rings: false; opacity: c.n >= 3 ? 1.0 : 0.35; }
        CoverTile { x: 8px + parent.cw; y: 8px + parent.cw; width: parent.cw; height: parent.cw; key: c.k4; hue: c.h4; radius: 12px; icon-size: 16px; rings: false; opacity: c.n >= 4 ? 1.0 : 0.35; }
    }
    Text {
        x: 12px;
        y: root.width - 20px + 18px;
        width: root.width - 24px;
        height: 19px;
        text: c.name;
        font-size: 16px;
        font-weight: 700;
        color: Theme.tx;
        overflow: elide;
    }
    Text {
        x: 12px;
        y: root.width - 20px + 40px;
        width: root.width - 24px;
        height: 16px;
        text: c.sub;
        font-size: 13px;
        color: Theme.smu;
    }
    TouchArea { clicked => { root.tapped(); } }
}

// -----------------------------------------------------------------------------
// Library: logo + search, chips + theme button, list panel. One scroll gesture:
// the header slides away first, then the glass panel sticks and its content scrolls.
// -----------------------------------------------------------------------------
component Library inherits Rectangle {
    property <length> hdr-h: 120px;
    property <length> view-h: AppState.win-h - 84px - AppState.safe-b;
    property <length> s: -fl.viewport-y;
    property <length> hy: -Math.min(s, hdr-h - 6px);
    property <length> top-y: Math.max(hdr-h - s, 6px);
    property <length> panel-w: AppState.win-w - 20px;
    property <length> panel-h: Math.max(60px, Math.min(AppState.list-content-h + 14px, view-h - top-y - 4px));
    property <length> t: Math.max(0px, s - (hdr-h - 6px));
    property <length> avail: AppState.win-w - 28px - 32px;
    property <length> sel-w: Math.max(avail / 6.05 * 2.05, 102px);
    property <length> other-w: (avail - sel-w) / 4;
    property <length> card-w: (panel-w - 12px - 16px - 12px) / 2;
    width: AppState.win-w;
    height: view-h;

    fl := Flickable {
        width: parent.width;
        height: parent.height;
        viewport-width: parent.width;
        viewport-height: root.view-h + (root.hdr-h - 6px) + Math.max(0px, AppState.list-content-h + 14px - (root.view-h - 10px));
        changed viewport-y => { AppState.scrolled(root.t); }

        Rectangle {
            x: 0px;
            y: -fl.viewport-y;
            width: fl.width;
            height: fl.height;
            clip: true;

            // ---- header (logo, search) -----------------------------------------
            Rectangle {
                y: root.hy;
                width: parent.width;
                height: root.hdr-h;
                LogoBars { x: 14px; y: 18.5px; w: 38px; }
                Glass {
                    x: 62px;
                    y: 10px;
                    width: parent.width - 62px - 14px;
                    height: 44px;
                    r: 22px;
                    Icon { d: Ic.srch; size: 20px; c: Theme.tx; x: 14px; y: 12px; }
                    TextInput {
                        x: 42px;
                        y: 12.5px;
                        width: parent.width - 42px - 44px;
                        height: 19px;
                        font-size: 16px;
                        color: Theme.tx;
                        text <=> AppState.query;
                        edited => { AppState.query-edited(self.text); }
                    }
                    if AppState.query == "" : Text {
                        x: 42px;
                        y: 12.5px;
                        text: "Search your music";
                        font-size: 16px;
                        color: Theme.mu;
                    }
                    if AppState.query != "" : Rectangle {
                        x: parent.width - 40px;
                        y: 4px;
                        width: 36px;
                        height: 36px;
                        border-radius: 18px;
                        Icon { d: Ic.x; size: 20px; c: Theme.mu; x: 8px; y: 8px; }
                        TouchArea { clicked => { AppState.query = ""; AppState.query-edited(""); } }
                    }
                }
                // ---- chips + theme button -----------------------------------------
                HorizontalLayout {
                    x: 0px;
                    y: 64px;
                    width: parent.width;
                    height: 48px;
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 8px;
                    Chip { icon: Ic.note; label: "Songs"; selected: AppState.tab == 0; width: AppState.tab == 0 ? root.sel-w : root.other-w; animate width { duration: 450ms; easing: ease-out; } tapped => { AppState.set-tab(0); } }
                    Chip { icon: Ic.disc; label: "Albums"; selected: AppState.tab == 1; width: AppState.tab == 1 ? root.sel-w : root.other-w; animate width { duration: 450ms; easing: ease-out; } tapped => { AppState.set-tab(1); } }
                    Chip { icon: Ic.mic; label: "Singers"; selected: AppState.tab == 2; width: AppState.tab == 2 ? root.sel-w : root.other-w; animate width { duration: 450ms; easing: ease-out; } tapped => { AppState.set-tab(2); } }
                    Chip { icon: Ic.queue; label: "Playlist"; selected: AppState.tab == 3; width: AppState.tab == 3 ? root.sel-w : root.other-w; animate width { duration: 450ms; easing: ease-out; } tapped => { AppState.set-tab(3); } }
                    Chip { icon: Ic.pal; label: ""; selected: false; width: root.other-w; tapped => { AppState.show-appearance = true; } }
                }
            }

            // ---- sticky glass panel ------------------------------------------------
            Glass {
                x: 10px;
                y: root.top-y;
                width: root.panel-w;
                height: root.panel-h;
                r: 28px;
                shadow: true;
                veil: Theme.lp;

                // songs / albums / singers rows (windowed by Rust)
                if AppState.tab < 3 || AppState.pl-view >= 0 : Rectangle {
                    for row[i] in AppState.rows : SongRow {
                        x: 6px;
                        width: root.panel-w - 12px;
                        y: 6px + AppState.rows-offset + (AppState.first-row + i) * 58px - root.t;
                        data: row;
                        current: row.kind == 0 && row.id == AppState.np-id;
                        tapped => { AppState.row-tapped(row.idx); }
                    }
                    if AppState.pl-view < 0 : Text {
                        x: 10px;
                        y: 6px + AppState.total-rows * 58px + 12px - root.t;
                        width: root.panel-w - 20px;
                        height: 18px;
                        text: AppState.footer;
                        font-size: 13px;
                        font-weight: 600;
                        color: Theme.smu;
                        horizontal-alignment: center;
                    }
                    if AppState.total-rows == 0 && AppState.pl-view < 0 : Text {
                        y: 40px;
                        width: root.panel-w;
                        height: 40px;
                        text: AppState.query != "" ? "Nothing found" : "No music found yet";
                        font-size: 16px;
                        font-weight: 600;
                        color: Theme.smu;
                        horizontal-alignment: center;
                    }
                }

                // playlist detail header
                if AppState.tab == 3 && AppState.pl-view >= 0 : Rectangle {
                    y: 6px - root.t;
                    height: 112px;
                    GButton { x: 8px; y: 6px; icon: Ic.back; clicked => { AppState.pl-open(-1); } }
                    Text {
                        x: 64px;
                        y: 6px;
                        width: root.panel-w - 64px - 64px;
                        height: 26px;
                        text: AppState.pl-title;
                        font-size: 22px;
                        font-weight: 800;
                        color: Theme.tx;
                        overflow: elide;
                    }
                    Text {
                        x: 64px;
                        y: 32px;
                        width: root.panel-w - 128px;
                        height: 16px;
                        text: AppState.pl-sub;
                        font-size: 13px;
                        color: Theme.smu;
                    }
                    GButton { x: root.panel-w - 52px; y: 6px; icon: Ic.edit; icon-size: 20px; clicked => { AppState.pl-edit(); } }
                    Glass {
                        x: 8px;
                        y: 58px;
                        width: (root.panel-w - 16px - 10px) / 2;
                        height: 48px;
                        r: 24px;
                        veil: Theme.acc1;
                        Icon { d: Ic.play; filled: true; c: Theme.acct; size: 18px; x: parent.width / 2 - 36px; y: 15px; }
                        Text { x: parent.width / 2 - 14px; y: 14px; text: "Play"; font-size: 15px; font-weight: 700; color: Theme.acct; }
                        TouchArea { clicked => { AppState.pl-play(false); } }
                    }
                    Glass {
                        x: 8px + (root.panel-w - 16px - 10px) / 2 + 10px;
                        y: 58px;
                        width: (root.panel-w - 16px - 10px) / 2;
                        height: 48px;
                        r: 24px;
                        Icon { d: Ic.shuf; c: Theme.tx; size: 20px; x: parent.width / 2 - 52px; y: 14px; }
                        Text { x: parent.width / 2 - 26px; y: 14px; text: "Shuffle"; font-size: 15px; font-weight: 700; color: Theme.tx; }
                        TouchArea { clicked => { AppState.pl-play(true); } }
                    }
                }

                // playlists grid / empty state
                if AppState.tab == 3 && AppState.pl-view < 0 : Rectangle {
                    if AppState.playlists.length == 0 : Rectangle {
                        y: 30px - root.t;
                        height: 280px;
                        Glass { x: (root.panel-w - 84px) / 2; y: 0px; width: 84px; height: 84px; r: 42px; Icon { d: Ic.queue; size: 36px; c: Theme.tx; x: 24px; y: 24px; } }
                        Text { y: 104px; width: root.panel-w; height: 26px; text: "Create your first playlist"; font-size: 20px; font-weight: 800; color: Theme.tx; horizontal-alignment: center; }
                        Text { x: (root.panel-w - 240px) / 2; y: 136px; width: 240px; height: 40px; text: "Group the songs you love in one place."; font-size: 15px; color: Theme.smu; horizontal-alignment: center; wrap: word-wrap; }
                        Glass {
                            x: (root.panel-w - 190px) / 2;
                            y: 192px;
                            width: 190px;
                            height: 52px;
                            r: 26px;
                            veil: Theme.acc1;
                            Icon { d: Ic.plus; size: 20px; c: Theme.acct; x: 24px; y: 16px; }
                            Text { x: 52px; y: 15px; text: "New playlist"; font-size: 16px; font-weight: 800; color: Theme.acct; }
                            TouchArea { clicked => { AppState.pl-new(); } }
                        }
                    }
                    if AppState.playlists.length > 0 : Rectangle {
                        Rectangle {
                            x: 8px;
                            y: 6px - root.t;
                            width: root.card-w;
                            height: 204px;
                            border-radius: 24px;
                            Rectangle { border-radius: 24px; background: Theme.g2; border-width: 1px; border-color: Theme.hi.with-alpha(0.35); }
                            Rectangle {
                                x: (parent.width - 48px) / 2;
                                y: 56px;
                                width: 48px;
                                height: 48px;
                                border-radius: 24px;
                                background: @linear-gradient(145deg, Theme.g1 0%, Theme.g2 100%);
                                Icon { d: Ic.plus; size: 22px; c: Theme.tx; x: 13px; y: 13px; }
                            }
                            Text { y: 118px; width: parent.width; height: 20px; text: "New playlist"; font-size: 15px; font-weight: 600; color: Theme.smu; horizontal-alignment: center; }
                            TouchArea { clicked => { AppState.pl-new(); } }
                        }
                        for pc[i] in AppState.playlists : PlaylistCard {
                            property <int> slot: i + 1;
                            x: 8px + Math.mod(slot, 2) * (root.card-w + 12px);
                            y: 6px + Math.floor(slot / 2) * 216px - root.t;
                            width: root.card-w;
                            height: 204px;
                            c: pc;
                            tapped => { AppState.pl-open(pc.id); }
                        }
                        Text {
                            y: 6px + Math.ceil((AppState.playlists.length + 1) / 2) * 216px + 6px - root.t;
                            width: root.panel-w;
                            height: 18px;
                            text: AppState.footer;
                            font-size: 13px;
                            font-weight: 600;
                            color: Theme.smu;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }
    }
}

// -----------------------------------------------------------------------------
// Mini player (HTML ".mini"): pill 64px, concentric 44px buttons
// -----------------------------------------------------------------------------
component MiniPlayer inherits Glass {
    x: 12px;
    width: AppState.win-w - 24px;
    height: 64px;
    y: AppState.win-h - 12px - AppState.safe-b - 64px;
    r: 32px;
    shadow: true;
    veil: Theme.b1.with-alpha(0.8);
    visible: AppState.has-track;
    opacity: AppState.show-np ? 0.0 : 1.0;
    animate opacity { duration: 300ms; }

    CoverTile {
        x: 10px;
        y: 10px;
        width: 44px;
        height: 44px;
        key: AppState.np-cover;
        hue: AppState.np-hue;
    }
    Text {
        x: 66px;
        y: 14.5px;
        width: root.width - 66px - 116px;
        height: 19px;
        text: AppState.np-title;
        font-size: 16px;
        font-weight: 600;
        color: Theme.tx;
        overflow: elide;
    }
    Text {
        x: 66px;
        y: 33.5px;
        width: root.width - 66px - 116px;
        height: 16px;
        text: AppState.np-artist;
        font-size: 14px;
        color: Theme.mu;
        overflow: elide;
    }
    TouchArea {
        width: root.width - 116px;
        clicked => { AppState.show-np = true; }
    }
    Rectangle {
        x: root.width - 10px - 44px - 10px - 44px;
        y: 10px;
        width: 44px;
        height: 44px;
        border-radius: 22px;
        background: @linear-gradient(145deg, Theme.g1 0%, Theme.g2 100%);
        border-width: 1px;
        border-color: Theme.lo;
        Icon { d: Ic.play; filled: true; size: 22px; x: 11px; y: 11px; opacity: AppState.playing ? 0.0 : 1.0; animate opacity { duration: 250ms; } }
        Icon { d: Ic.pause; filled: true; size: 22px; x: 11px; y: 11px; opacity: AppState.playing ? 1.0 : 0.0; animate opacity { duration: 250ms; } }
        TouchArea { clicked => { AppState.toggle-play(); } }
    }
    Rectangle {
        x: root.width - 10px - 44px;
        y: 10px;
        width: 44px;
        height: 44px;
        border-radius: 22px;
        background: @linear-gradient(145deg, Theme.g1 0%, Theme.g2 100%);
        border-width: 1px;
        border-color: Theme.lo;
        Icon { d: Ic.next; filled: true; size: 22px; x: 11px; y: 11px; }
        TouchArea { clicked => { AppState.next(); } }
    }
}

// -----------------------------------------------------------------------------
// Now playing (HTML ".sheet > .np"): glass card 332 x min(700, h-24), radius 40
// -----------------------------------------------------------------------------
component NowPlaying inherits Rectangle {
    property <float> t: AppState.show-np ? 1.0 : 0.0;
    animate t { duration: 420ms; easing: ease-out; }
    x: 0px;
    width: AppState.win-w;
    height: AppState.win-h;
    y: (1.0 - t) * AppState.win-h;
    visible: t > 0.002;

    property <length> np-h: Math.min(700px, AppState.win-h - 24px);
    property <length> inner-w: AppState.win-w - 28px - 36px;
    property <length> h0: AppState.win-h < 620px ? Math.clamp(AppState.win-h - 315px, 110px, 300px) : Math.clamp(AppState.win-h - 380px, 110px, 300px);
    property <int> cs: AppState.cover-style;
    property <length> art-w: cs == 0 ? Math.min(inner-w, h0 * 1.2) : (cs == 4 ? inner-w : (cs == 5 ? Math.min(inner-w, h0 * 0.82) : Math.min(inner-w, h0 * 0.88)));
    property <length> art-h: cs == 0 ? art-w / 1.2 : (cs == 4 ? art-w / 1.6 : (cs == 5 ? art-w / 0.88 : art-w));

    Glass {
        x: 14px;
        y: (AppState.win-h - root.np-h) / 2;
        width: AppState.win-w - 28px;
        height: root.np-h;
        r: 40px;
        shadow: true;
        veil: Theme.dark-veil;

        VerticalLayout {
            padding-left: 18px;
            padding-right: 18px;
            padding-top: 16px;
            padding-bottom: 18px;
            alignment: space-between;

            // ---- top bar -------------------------------------------------------
            Rectangle {
                height: 44px;
                GButton { x: 0px; icon: Ic.down; clicked => { AppState.show-np = false; } }
                Text {
                    width: parent.width;
                    height: parent.height;
                    text: "Now Playing";
                    font-size: 17px;
                    font-weight: 500;
                    color: Theme.tx;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                GButton { x: parent.width - 44px; icon: Ic.tune; clicked => { AppState.show-custom = true; } }
            }

            // ---- cover ----------------------------------------------------------
            Rectangle {
                height: root.art-h;
                Rectangle {
                    x: (parent.width - root.art-w) / 2;
                    width: root.art-w;
                    height: root.art-h;

                    // card / square / wide / circle
                    if root.cs != 2 && root.cs != 5 : Rectangle {
                        border-radius: root.cs == 3 ? self.width / 2 : 28px;
                        drop-shadow-blur: Theme.flat ? 0px : 40px;
                        drop-shadow-offset-y: 20px;
                        drop-shadow-color: Theme.sh;
                        CoverTile {
                            radius: root.cs == 3 ? self.width / 2 : 28px;
                            icon-size: 72px;
                            key: AppState.np-cover;
                            hue: AppState.np-hue;
                        }
                    }
                    // frame (polaroid)
                    if root.cs == 5 : Glass {
                        r: 16px;
                        shadow: true;
                        CoverTile {
                            x: 10px;
                            y: 10px;
                            width: parent.width - 20px;
                            height: parent.height - 44px;
                            radius: 8px;
                            icon-size: 64px;
                            key: AppState.np-cover;
                            hue: AppState.np-hue;
                        }
                    }
                    // glass disc: rotating body + fixed sheen
                    if root.cs == 2 : Rectangle {
                        Image {
                            width: parent.width;
                            height: parent.height;
                            source: Theme.disc;
                            rotation-angle: AppState.disc-angle;
                        }
                        Image {
                            width: parent.width;
                            height: parent.height;
                            source: Walls.sheen;
                        }
                    }
                    // heart
                    GButton {
                        size: root.cs == 5 ? 34px : 40px;
                        icon-size: root.cs == 5 ? 17px : 20px;
                        icon: Ic.heart;
                        filled-icon: AppState.liked;
                        icon-color: AppState.liked ? Theme.like : Theme.tx;
                        x: parent.width - self.width - ((root.cs == 2 || root.cs == 3) ? Math.max(0px, parent.width * 0.146 - 20px) : (root.cs == 5 ? 6px : 10px));
                        y: parent.height - self.height - ((root.cs == 2 || root.cs == 3) ? Math.max(0px, parent.width * 0.146 - 20px) : (root.cs == 5 ? 0px : 10px));
                        clicked => { AppState.toggle-like(); }
                    }
                }
            }

            // ---- title ------------------------------------------------------------
            Rectangle {
                height: 46px;
                Text {
                    y: 0px;
                    width: parent.width;
                    height: 25px;
                    text: AppState.np-title;
                    font-size: 22px;
                    font-weight: 700;
                    color: Theme.tx;
                    horizontal-alignment: center;
                    overflow: elide;
                }
                Text {
                    y: 27px;
                    width: parent.width;
                    height: 19px;
                    text: AppState.np-artist;
                    font-size: 16px;
                    color: Theme.smu;
                    horizontal-alignment: center;
                    overflow: elide;
                }
            }

            // ---- seek ------------------------------------------------------------------
            Rectangle {
                height: 55px;
                SeekBar { y: 0px; width: parent.width; value: AppState.progress; seeked(v) => { AppState.seek(v); } }
                Text { y: 40px; text: AppState.t-cur; font-size: 13px; color: Theme.smu; }
                Text { y: 40px; width: parent.width; horizontal-alignment: right; text: AppState.t-dur; font-size: 13px; color: Theme.smu; }
            }

            // ---- transport (shuffle, prev, play, next, repeat: space-between like the HTML) ----
            HorizontalLayout {
                height: 64px;
                padding-left: 4px;
                padding-right: 4px;
                alignment: space-between;
                Rectangle {
                    width: 40px;
                    GhostButton {
                        y: 12px;
                        icon: Ic.shuf;
                        icon-size: 21px;
                        icon-color: AppState.shuffle ? Theme.ttl : Theme.tx;
                        clicked => { AppState.toggle-shuffle(); }
                    }
                    if AppState.shuffle : Rectangle { x: 17.5px; y: 47px; width: 5px; height: 5px; border-radius: 2.5px; background: Theme.a2; }
                }
                Rectangle {
                    width: 42px;
                    GhostButton {
                        y: 11px;
                        size: 42px;
                        icon: Ic.prev;
                        icon-size: 22px;
                        filled-icon: true;
                        clicked => { AppState.prev(); }
                    }
                }
                Rectangle {
                    width: 64px;
                    // orbit ring for the first 5 seconds of every track
                    if AppState.intro : Rectangle {
                        for k in 10 : Rectangle {
                            property <angle> a: AppState.phase * 10 - k * 14deg;
                            x: 32px - 2.5px + 38px * Math.cos(a);
                            y: 32px - 2.5px + 38px * Math.sin(a);
                            width: 5px;
                            height: 5px;
                            border-radius: 2.5px;
                            background: Theme.a1;
                            opacity: 1.0 - k * 0.09;
                        }
                    }
                    Glass {
                        r: 32px;
                        shadow: true;
                        Icon { d: Ic.play; filled: true; size: 26px; x: 19px; y: 19px; opacity: AppState.playing ? 0.0 : 1.0; animate opacity { duration: 300ms; } }
                        Icon { d: Ic.pause; filled: true; size: 26px; x: 19px; y: 19px; opacity: AppState.playing ? 1.0 : 0.0; animate opacity { duration: 300ms; } }
                        TouchArea { clicked => { AppState.toggle-play(); } }
                    }
                }
                Rectangle {
                    width: 42px;
                    GhostButton {
                        y: 11px;
                        size: 42px;
                        icon: Ic.next;
                        icon-size: 22px;
                        filled-icon: true;
                        clicked => { AppState.next(); }
                    }
                }
                Rectangle {
                    width: 40px;
                    GhostButton {
                        y: 12px;
                        icon: Ic.rep;
                        icon-size: 21px;
                        icon-color: AppState.repeat > 0 ? Theme.ttl : Theme.tx;
                        clicked => { AppState.cycle-repeat(); }
                    }
                    if AppState.repeat == 2 : Text { x: 24px; y: 17px; text: "1"; font-size: 10px; font-weight: 800; color: Theme.ttl; }
                    if AppState.repeat > 0 : Rectangle { x: 17.5px; y: 47px; width: 5px; height: 5px; border-radius: 2.5px; background: Theme.a2; }
                }
            }

            // ---- equalizer pill (visual) -------------------------------------------------
            if AppState.eq-look != 5 : Glass {
                height: 52px;
                r: 24px;
                shadow: true;
                property <int> n: AppState.eq-look == 4 ? 17 : 34;
                property <length> bw: AppState.eq-look == 3 ? 2px : (AppState.eq-look == 4 ? 9px : 4px);
                property <length> span: root.inner-w - 28px - self.bw;
                for i in n : Rectangle {
                    property <float> idx: AppState.eq-look == 4 ? i * 2.0 + 1.0 : i * 1.0;
                    property <float> m: Math.min(1.0, (0.3 + 0.7 * Math.sin((idx + 0.5) / 34.0 * 180deg)) * (0.7 + Math.mod(idx * 29.0, 30.0) / 100.0));
                    property <float> wave: 0.5 + 0.5 * Math.sin(AppState.phase * (1.0 + Math.mod(idx * 53.0, 60.0) / 100.0) * 3.0 + Math.mod(idx * 37.0, 100.0) * 3.6deg);
                    property <float> lv: AppState.playing ? 0.12 + (m - 0.12) * wave : m * 0.4;
                    x: 14px + i * (parent.span / (parent.n - 1));
                    width: parent.bw;
                    height: AppState.eq-look == 2 ? parent.bw : 32px * lv;
                    y: AppState.eq-look == 1 ? 10px + 32px - self.height : (AppState.eq-look == 2 ? 26px - parent.bw / 2 + (AppState.playing ? (9px - (9px + 12px * m) * wave) : 0px) : (52px - self.height) / 2);
                    border-radius: self.width / 2;
                    background: AppState.eq-look == 1 ? Theme.a1 : Theme.tx;
                    opacity: 0.92;
                }
            }
        }
    }
}

// -----------------------------------------------------------------------------
// Bottom sheet frame (HTML ".apsheet"): slide-in, grabber, swipe-down-to-close
// -----------------------------------------------------------------------------
component SheetFrame inherits Rectangle {
    in property <bool> open;
    in property <length> content-h;
    in property <string> title;
    callback closed();
    property <float> t: open ? 1.0 : 0.0;
    animate t { duration: 380ms; easing: ease-out; }
    property <length> drag: 0px;
    property <length> max-h: AppState.win-h - AppState.safe-t - 20px;
    property <length> full-h: 64px + content-h + 16px;
    x: 10px;
    width: AppState.win-w - 20px;
    height: Math.min(full-h, max-h);
    y: (AppState.win-h + 20px) + ((AppState.win-h - AppState.safe-b - 10px - self.height) - (AppState.win-h + 20px)) * t + drag;
    visible: t > 0.002;

    Glass {
        r: 32px;
        shadow: true;
        veil: Theme.b1.with-alpha(0.9);
        Rectangle {
            x: (parent.width - 40px) / 2;
            y: 10px;
            width: 40px;
            height: 4px;
            border-radius: 2px;
            background: Theme.mu.with-alpha(0.4);
        }
        Text {
            x: 16px;
            y: 30px;
            width: parent.width - 16px - 76px;
            height: 24px;
            text: root.title;
            font-size: 20px;
            font-weight: 800;
            color: Theme.tx;
            overflow: elide;
        }
        GButton {
            x: parent.width - 16px - 44px;
            y: 20px;
            icon: Ic.x;
            clicked => { root.closed(); }
        }
        Flickable {
            y: 64px;
            width: parent.width;
            height: parent.height - 64px;
            viewport-width: parent.width;
            viewport-height: root.content-h + 16px;
            @children
        }
        // swipe down on the header zone to close
        TouchArea {
            width: parent.width - 76px;
            height: 66px;
            moved => {
                if (self.pressed) {
                    root.drag = Math.max(0px, self.mouse-y - self.pressed-y);
                }
            }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                    if (root.drag > 90px) { root.closed(); }
                    root.drag = 0px;
                }
            }
        }
    }
}

// ---- Appearance sheet ---------------------------------------------------------------
component AppearanceSheet inherits SheetFrame {
    open: AppState.show-appearance;
    title: "Appearance";
    content-h: 511px;
    closed => { AppState.show-appearance = false; }
    VerticalLayout {
        x: 16px;
        width: parent.width - 32px;
        alignment: start;
        Sect { text: "Color"; }
        HorizontalLayout {
            height: 82px;
            spacing: 8px;
            PalCard { idx: 0; label: Names.pal[0]; selected: AppState.pal == 0; tapped => { AppState.set-pal(0); } }
            PalCard { idx: 1; label: Names.pal[1]; selected: AppState.pal == 1; tapped => { AppState.set-pal(1); } }
            PalCard { idx: AppState.pal >= 3 ? AppState.pal : 2; label: Names.pal[self.idx]; selected: AppState.pal == self.idx; tapped => { AppState.set-pal(self.idx); } }
            PalCard { more: true; label: "More"; tapped => { AppState.more-kind = 0; } }
        }
        Sect { text: "Background"; }
        HorizontalLayout {
            height: 116px;
            spacing: 8px;
            WallCard { style: 0; label: Names.wall[0]; selected: AppState.wall == 0; tapped => { AppState.set-wall(0); } }
            WallCard { style: 1; label: Names.wall[1]; selected: AppState.wall == 1; tapped => { AppState.set-wall(1); } }
            WallCard { style: AppState.wall >= 3 ? AppState.wall : 2; label: Names.wall[self.style]; selected: AppState.wall == self.style; tapped => { AppState.set-wall(self.style); } }
            WallCard { more: true; label: "More"; tapped => { AppState.more-kind = 1; } }
        }
        Sect { text: "Performance"; }
        HorizontalLayout {
            height: 75px;
            spacing: 8px;
            OptCard { group: 2; k: 0; label: "Max"; selected: AppState.perf == 0; tapped => { AppState.set-perf(0); } }
            OptCard { group: 2; k: 1; label: "Balanced"; selected: AppState.perf == 1; tapped => { AppState.set-perf(1); } }
            OptCard { group: 2; k: 2; label: "Optimized"; selected: AppState.perf == 2; tapped => { AppState.set-perf(2); } }
        }
        Rectangle {
            height: 70px;
            Text {
                y: 8px;
                width: parent.width;
                height: 50px;
                text: "Max = liquid glass look (heaviest) · Balanced = same look, lighter · Optimized = smoothest";
                font-size: 12px;
                color: Theme.smu;
                wrap: word-wrap;
            }
        }
        ModeRow {
            two-line: true;
            icon: AppState.dark ? Ic.moon : Ic.sun;
            title: "Dark mode";
            sub: "Easier on the eyes at night";
            Switch { x: parent.width - 70px; y: (parent.height - 32px) / 2; on: AppState.dark; toggled => { AppState.set-dark(!AppState.dark); } }
        }
    }
}

// ---- Customize sheet (opened from the Now Playing screen) -----------------------------------
component CustomSheet inherits SheetFrame {
    open: AppState.show-custom;
    title: "Customize player";
    content-h: 749px;
    closed => { AppState.show-custom = false; }
