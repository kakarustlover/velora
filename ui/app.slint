            height: 75px;
            spacing: 8px;
            OptCard { group: 0; k: 0; label: Names.cover[0]; selected: AppState.cover-style == 0; tapped => { AppState.set-cover-style(0); } }
            OptCard { group: 0; k: 1; label: Names.cover[1]; selected: AppState.cover-style == 1; tapped => { AppState.set-cover-style(1); } }
            OptCard { group: 0; k: AppState.cover-style >= 3 ? AppState.cover-style : 2; label: Names.cover[self.k]; selected: AppState.cover-style == self.k; tapped => { AppState.set-cover-style(self.k); } }
            OptCard { group: 3; k: 0; label: "More"; tapped => { AppState.more-kind = 2; } }
        }
