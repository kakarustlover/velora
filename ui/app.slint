            OptCard { group: 2; k: 0; label: "Max"; selected: AppState.perf == 0; tapped => { AppState.set-perf(0); } }
            OptCard { group: 2; k: 1; label: "Balanced"; selected: AppState.perf == 1; tapped => { AppState.set-perf(1); } }
            OptCard { group: 2; k: 2; label: "Optimized"; selected: AppState.perf == 2; tapped => { AppState.set-perf(2); } }
        }
        Sect { text: "Theme"; }
        HorizontalLayout {
            height: 82px;
            spacing: 8px;
            PalCard { idx: 0; label: Names.pal[0]; selected: AppState.pal == 0; tapped => { AppState.set-pal(0); } }
            PalCard { idx: 1; label: Names.pal[1]; selected: AppState.pal == 1; tapped => { AppState.set-pal(1); } }
            PalCard { idx: AppState.pal >= 3 ? AppState.pal : 2; label: Names.pal[self.idx]; selected: AppState.pal == self.idx; tapped => { AppState.set-pal(self.idx); } }
            PalCard { more: true; label: "More"; tapped => { AppState.more-kind = 0; } }
        }
        Rectangle { height: 8px; }
        ModeRow {
            icon: AppState.dark ? Ic.moon : Ic.sun;
            title: "Dark mode";
            Switch { x: parent.width - 70px; y: (parent.height - 32px) / 2; on: AppState.dark; toggled => { AppState.set-dark(!AppState.dark); } }
        }
        Sect { text: "Wallpaper"; }
        HorizontalLayout {
            height: 116px;
            spacing: 8px;
            WallCard { style: 0; label: Names.wall[0]; selected: AppState.wall == 0; tapped => { AppState.set-wall(0); } }
            WallCard { style: 1; label: Names.wall[1]; selected: AppState.wall == 1; tapped => { AppState.set-wall(1); } }
            WallCard { style: AppState.wall >= 3 ? AppState.wall : 2; label: Names.wall[self.style]; selected: AppState.wall == self.style; tapped => { AppState.set-wall(self.style); } }
            WallCard { more: true; label: "More"; tapped => { AppState.more-kind = 1; } }
        }
    }
}

// ---- Equalizer & Bass sheet ---------------------------------------------------------------
component EqSheet inherits SheetFrame {
    open: AppState.show-eq;
    title: "Equalizer & Bass";
    content-h: 578px;
    closed => { AppState.show-eq = false; }
    VerticalLayout {
        x: 16px;
        width: parent.width - 32px;
        alignment: start;
        spacing: 0px;
        Rectangle { height: 8px; }
        ModeRow {
            icon: Ic.eqicon;
            title: "Equalizer";
            sub: "Shape every frequency";
            Switch { x: parent.width - 70px; y: (parent.height - 32px) / 2; on: AppState.eq-on; toggled => { AppState.eq-toggle(); } }
        }
        Rectangle { height: 8px; }
        // presets (horizontal scroll)
        Flickable {
            height: 58px;
            viewport-width: 9 * 86px + 8px;
            for p[i] in Names.preset : Rectangle {
                x: i * 86px;
                y: 10px;
                width: 80px;
                height: 40px;
                border-radius: 20px;
                background: AppState.eq-preset == i ? Theme.acc1 : Theme.g2;
                Text {
                    text: p;
                    font-size: 14px;
                    font-weight: AppState.eq-preset == i ? 800 : 600;
                    color: AppState.eq-preset == i ? Theme.acct : Theme.smu;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea { clicked => { if (i < 8) { AppState.eq-pick-preset(i); } } }
            }
        }
        Rectangle { height: 2px; }
        // response curve
        Rectangle {
            height: 64px;
            opacity: AppState.eq-on ? 1.0 : 0.4;
            Rectangle { y: 32px; width: parent.width; height: 1px; background: Theme.smu.with-alpha(0.4); }
            Path {
                width: parent.width;
                height: parent.height;
                viewbox-width: 320;
                viewbox-height: 64;
                commands: AppState.eq-curve;
                stroke: Theme.tx;
                stroke-width: 2px;
                fill: Theme.a1.with-alpha(0.28);
                stroke-line-cap: round;
                stroke-line-join: round;
            }
        }
        Rectangle { height: 6px; }
        // ten bands (value on top, slider, frequency below)
        Rectangle {
            height: 168px;
            opacity: AppState.eq-on ? 1.0 : 0.4;
            for hz[i] in Names.hz : Rectangle {
                x: i * (parent.width / 10);
                width: parent.width / 10;
                Text {
                    y: 0px;
                    width: parent.width;
                    height: 14px;
                    text: (AppState.eq-bands[i] > 0 ? "+" : "") + "\{AppState.eq-bands[i]}";
                    font-size: 11px;
                    font-weight: 700;
                    color: Theme.smu;
                    horizontal-alignment: center;
                }
                VSlider {
                    y: 18px;
                    height: 132px;
                    value: AppState.eq-bands[i];
                    value-changed(v) => { AppState.eq-band(i, v); }
                }
                Text {
                    y: 152px;
                    width: parent.width;
                    height: 16px;
                    text: hz;
                    font-size: 12px;
                    font-weight: 600;
                    color: Theme.smu;
                    horizontal-alignment: center;
                }
            }
        }
        Rectangle { height: 8px; }
        // bass / treble / preamp
        for k[i] in ["Bass", "Treble", "Preamp"] : Rectangle {
            height: 48px;
            opacity: AppState.eq-on ? 1.0 : 0.4;
            Text { y: 14px; width: 64px; height: 20px; text: k; font-size: 15px; font-weight: 700; color: Theme.tx; }
            HSlider {
                x: 74px;
                width: parent.width - 74px - 72px;
                value: i == 0 ? AppState.eq-bass : (i == 1 ? AppState.eq-treble : AppState.eq-pre);
                value-changed(v) => { AppState.eq-knob(i, v); }
            }
            Text {
                x: parent.width - 62px;
                y: 16px;
                width: 62px;
                height: 16px;
                text: ((i == 0 ? AppState.eq-bass : (i == 1 ? AppState.eq-treble : AppState.eq-pre)) > 0 ? "+" : "") + "\{(i == 0 ? AppState.eq-bass : (i == 1 ? AppState.eq-treble : AppState.eq-pre))} dB";
                font-size: 13px;
                font-weight: 600;
                color: Theme.smu;
                horizontal-alignment: right;
            }
        }
        Rectangle { height: 8px; }
        Rectangle {
            height: 44px;
            Glass {
                x: (parent.width - 127px) / 2;
                width: 127px;
                height: 44px;
                r: 22px;
                Text { text: "Reset all"; font-size: 16px; font-weight: 700; color: Theme.smu; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { clicked => { AppState.eq-reset(); } }
            }
        }
    }
}

// ---- Playlist editor ---------------------------------------------------------------------------
component PlaylistEditor inherits SheetFrame {
    open: AppState.show-pl-editor;
    title: AppState.pl-editing ? "Edit playlist" : "New playlist";
    content-h: 422px;
    closed => { AppState.pl-close-editor(); }
    VerticalLayout {
        x: 16px;
        width: parent.width - 32px;
        alignment: start;
        spacing: 0px;
        Rectangle { height: 8px; }
        Glass {
            height: 52px;
            r: 26px;
            Icon { d: Ic.queue; size: 20px; c: Theme.smu; x: 16px; y: 16px; }
            TextInput {
                x: 46px;
                y: 16px;
                width: parent.width - 46px - 16px;
                height: 20px;
                font-size: 16px;
                color: Theme.tx;
                text <=> AppState.pl-name;
                edited => { AppState.pl-name-edited(self.text); }
            }
            if AppState.pl-name == "" : Text { x: 46px; y: 16px; text: "Playlist name"; font-size: 16px; color: Theme.mu; }
        }
        Rectangle { height: 12px; }
        Rectangle {
            height: 18px;
            Text { x: 4px; y: 0px; text: "Songs"; font-size: 15px; font-weight: 700; color: Theme.tx; }
            Text { x: parent.width - 124px; y: 2px; width: 120px; text: AppState.pl-count; font-size: 13px; color: Theme.smu; horizontal-alignment: right; }
        }
        Rectangle { height: 8px; }
        Rectangle {
            height: 260px;
            border-radius: 22px;
            background: Theme.g2;
            clip: true;
            Flickable {
                viewport-height: AppState.pick-rows.length * 56px + 8px;
                for pr[i] in AppState.pick-rows : Rectangle {
                    x: 4px;
                    y: 4px + i * 56px;
                    width: parent.width - 8px;
                    height: 56px;
                    border-radius: 18px;
                    background: pr.sel ? Theme.g2 : transparent;
                    CoverTile { x: 10px; y: 8px; width: 40px; height: 40px; key: pr.cover; hue: pr.hue; radius: 12px; icon-size: 18px; rings: false; }
                    Text { x: 62px; y: 10px; width: parent.width - 62px - 56px; height: 19px; text: pr.title; font-size: 16px; font-weight: 600; color: Theme.tx; overflow: elide; }
                    Text { x: 62px; y: 30px; width: parent.width - 62px - 56px; height: 16px; text: pr.sub; font-size: 14px; color: Theme.mu; overflow: elide; }
                    Rectangle {
                        x: parent.width - 36px;
                        y: 15px;
                        width: 26px;
                        height: 26px;
                        border-radius: 13px;
                        border-width: pr.sel ? 0px : 1.5px;
                        border-color: Theme.smu;
                        background: pr.sel ? @linear-gradient(145deg, Theme.acc1 0%, Theme.acc2 100%) : @linear-gradient(145deg, #00000000 0%, #00000000 100%);
                        if pr.sel : Icon { d: Ic.check; size: 15px; c: Theme.acct; x: 5.5px; y: 5.5px; }
                    }
                    TouchArea { clicked => { AppState.pl-toggle-pick(pr.idx); } }
                }
            }
        }
        Rectangle { height: 12px; }
        HorizontalLayout {
            height: 52px;
            spacing: 10px;
            if AppState.pl-editing : Glass {
                r: 26px;
                veil: AppState.pl-del-armed ? Theme.like : transparent;
                Text {
                    text: AppState.pl-del-armed ? "Tap again to delete" : "Delete playlist";
                    font-size: 16px;
                    font-weight: 800;
                    color: AppState.pl-del-armed ? #ffffff : Theme.like;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea { clicked => { AppState.pl-delete(); } }
            }
            Glass {
                r: 26px;
                veil: Theme.acc1;
                opacity: AppState.pl-can-save ? 1.0 : 0.45;
                Text {
                    text: AppState.pl-editing ? "Save" : "Create";
                    font-size: 16px;
                    font-weight: 800;
                    color: Theme.acct;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea { enabled: AppState.pl-can-save; clicked => { AppState.pl-save(); } }
            }
        }
    }
}

// ---- "More" popover (colors / wallpapers / covers / equalizer looks) -------------------------------
component MorePopover inherits Rectangle {
    property <float> t: AppState.more-kind >= 0 ? 1.0 : 0.0;
    animate t { duration: 320ms; easing: ease-out; }
    property <length> pw: Math.min(AppState.win-w * 0.9, 372px);
    property <length> inner: pw - 32px;
    property <length> cw: (inner - 4px - 20px) / 3;
    property <int> count: AppState.more-kind == 0 ? 10 : (AppState.more-kind == 1 ? 5 : 6);
    property <length> item-h: AppState.more-kind == 0 ? 88px : (AppState.more-kind == 1 ? 124.3px : 75px);
    property <float> rows: Math.ceil(count / 3.0);
    property <length> grid-h: rows * item-h + (rows - 1) * 10px + 8px;
    property <length> ph: Math.min(48px + grid-h + 18px, AppState.win-h * 0.7);
    visible: t > 0.002;
    width: pw;
    height: ph;
    x: (AppState.win-w - pw) / 2;
    y: (AppState.win-h - ph) / 2 + (1.0 - t) * 24px;
    opacity: t;

    Glass {
        r: 30px;
        shadow: true;
        veil: Theme.b1.with-alpha(0.92);
        Text {
            y: 16px;
            width: parent.width;
            height: 20px;
            text: AppState.more-kind == 0 ? "More colors" : (AppState.more-kind == 1 ? "More wallpapers" : (AppState.more-kind == 2 ? "More cover styles" : "More equalizer styles"));
            font-size: 17px;
            font-weight: 800;
            color: Theme.tx;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        GButton { x: parent.width - 16px - 44px; y: 4px; icon: Ic.x; clicked => { AppState.more-kind = -1; } }
        Flickable {
            x: 16px;
            y: 48px;
            width: parent.width - 32px;
            height: parent.height - 48px - 18px;
            viewport-height: root.grid-h;
            for i in root.count : Rectangle {
                x: 2px + Math.mod(i, 3) * (root.cw + 10px);
                y: 2px + Math.floor(i / 3.0) * (root.item-h + 10px);
                width: root.cw;
                height: root.item-h;
                if AppState.more-kind == 0 : PalCard { idx: i; label: Names.pal[i]; selected: AppState.pal == i; tapped => { AppState.set-pal(i); } }
                if AppState.more-kind == 1 : WallCard { style: i; label: Names.wall[i]; selected: AppState.wall == i; tapped => { AppState.set-wall(i); } }
                if AppState.more-kind == 2 : OptCard { group: 0; k: i; label: Names.cover[i]; selected: AppState.cover-style == i; tapped => { AppState.set-cover-style(i); } }
                if AppState.more-kind == 3 : OptCard { group: 1; k: i; label: Names.eqlook[i]; selected: AppState.eq-look == i; tapped => { AppState.set-eq-look(i); } }
            }
        }
    }
}

// -----------------------------------------------------------------------------
// Splash (HTML ".splash"): gradient, glass tile with animated logo, title
// -----------------------------------------------------------------------------
component Splash inherits Rectangle {
    width: AppState.win-w;
    height: AppState.win-h;
    background: @linear-gradient(165deg, Theme.a1 0%, Theme.a2 36%, Theme.a2.darker(0.35) 72%, Theme.deep 100%);
    opacity: AppState.splash ? 1.0 : 0.0;
    animate opacity { duration: 600ms; delay: 300ms; }
    visible: AppState.splash || self.opacity > 0.01;
    if AppState.splash : TouchArea { }
    Rectangle {
        x: (parent.width - 120px) / 2;
        y: parent.height / 2 - 150px;
        width: 120px;
        height: 90px;
        border-radius: 30px;
        background: #ffffff29;
        border-width: 1px;
        border-color: #ffffff40;
        drop-shadow-blur: 36px;
        drop-shadow-offset-y: 16px;
        drop-shadow-color: #00000040;
        LogoBars { x: 25px; y: 20px; w: 70px; c: #ffffff; }
    }
    Text { x: 0px; y: parent.height / 2 - 40px; width: parent.width; height: 50px; text: "Velora"; font-size: 44px; font-weight: 800; color: #ffffff; horizontal-alignment: center; }
    Text { x: 0px; y: parent.height / 2 + 20px; width: parent.width; height: 56px; text: "Written entirely in Rust.\nFast and powerful."; font-size: 19px; font-weight: 600; color: #ffffff; horizontal-alignment: center; }
}

// =============================================================================
export component MainWindow inherits Window {
    preferred-width: 360px;
    preferred-height: 800px;
    background: Theme.b2;
    default-font-family: "Inter";
    title: "Velora";

    changed width => { AppState.win-w = self.width; }
    changed height => { AppState.win-h = self.height; }
    init => {
        AppState.win-w = self.width;
        AppState.win-h = self.height;
    }

    property <bool> any-sheet: AppState.show-appearance || AppState.show-custom || AppState.show-eq || AppState.show-pl-editor;

    Image { width: parent.width; height: parent.height; source: Theme.wall; image-fit: cover; }
    Library { }
    MiniPlayer { }
    NowPlaying { }

    // dim layer behind sheets (tap to close)
    Rectangle {
        background: #00000047;
        opacity: (root.any-sheet || AppState.more-kind >= 0) ? 1.0 : 0.0;
        animate opacity { duration: 300ms; }
        visible: self.opacity > 0.01;
        TouchArea {
            clicked => {
                if (AppState.more-kind >= 0) {
                    AppState.more-kind = -1;
                } else if (AppState.show-eq) {
                    AppState.show-eq = false;
                } else if (AppState.show-pl-editor) {
                    AppState.pl-close-editor();
                } else {
                    AppState.show-appearance = false;
                    AppState.show-custom = false;
                }
            }
        }
    }
    AppearanceSheet { }
    CustomSheet { }
    PlaylistEditor { }
    EqSheet { }
    MorePopover { }
    Splash { }
}
